@model IEnumerable<Aula_Backend.Models.Consumo>

@{
    ViewData["Title"] = "Relatório";
}

<h1>Relatório de: @ViewBag.Veiculo.Nome</h1>

<h3>Valor total: @ViewBag.Total</h3>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Km)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Combustivel)
            </th>
            <th>
                Veículo
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(model => item.Data)
            </td>
            <td>
                @Html.DisplayFor(model => item.Valor)
            </td>
            <td>
                @Html.DisplayFor(model => item.Km)
            </td>
            <td>
                @Html.DisplayFor(model => item.Combustivel)
            </td>
            <td>
                @Html.DisplayFor(model => item.Veiculo.Nome)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
