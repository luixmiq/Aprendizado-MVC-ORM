@model Aula_Backend.Models.Consumo

@{
    ViewData["Title"] = "Consumo";
}

<h1>Consumo</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Data)
        </dt>
        <dd class = "col-sm-6">
            @Model.Data.ToString("dd/MM/yyyy HH:mm")
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Valor)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Valor)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Km)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Km)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Combustivel)
        </dt>
        <dd class = "col-sm-6">
            @Html.DisplayFor(model => model.Combustivel)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Veículo
        </dt>
        <dd class = "col-sm-6">
            @Model.Veiculo.Nome
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Editar</a> 
    <a asp-action="Index" class="btn btn-info">Voltar</a>
</div>
